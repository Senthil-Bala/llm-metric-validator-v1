# Select exactly one configured provider: gemini or deepseek.
LLM_PROVIDER=deepseek
# Optional generation temperature (0-2). Omit to use the provider default.
LLM_TEMPERATURE=
# Request timeout in milliseconds (default 20000; max 120000).
LLM_REQUEST_TIMEOUT_MS=
# DeepSeek only: optionally set enabled or disabled. Omit to use the provider default.
DEEPSEEK_THINKING_MODE=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Gemini (set LLM_PROVIDER=gemini to use these settings)
GEMINI_API_KEY=
GEMINI_MODEL=
